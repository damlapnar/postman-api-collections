{
  "info": {
    "name": "Users API",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Complete test suite for the Users REST API \u2014 CRUD, pagination, edge cases",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Users - Page 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has data array', () => { const b = pm.response.json(); pm.expect(b.data).to.be.an('array').with.lengthOf.above(0); });",
              "pm.test('Has pagination fields', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('page','per_page','total','total_pages','data'); });",
              "pm.test('Response time < 800ms', () => pm.expect(pm.response.responseTime).to.be.below(800));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users?page=1"
      }
    },
    {
      "name": "Get Users - Page 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Page 2 returned', () => pm.expect(pm.response.json().page).to.eql(2));",
              "pm.test('Data is non-empty', () => pm.expect(pm.response.json().data.length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users?page=2"
      }
    },
    {
      "name": "Get Single User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('User ID is 2', () => pm.expect(pm.response.json().data.id).to.eql(2));",
              "pm.test('Has email field', () => pm.expect(pm.response.json().data.email).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/2"
      }
    },
    {
      "name": "Get Non-existent User - 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Empty body', () => pm.expect(pm.response.json()).to.eql({}));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/9999"
      }
    },
    {
      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns id', () => { const b = pm.response.json(); pm.expect(b.id).to.exist; pm.environment.set('createdUserId', b.id); });",
              "pm.test('Returns correct name', () => pm.expect(pm.response.json().name).to.eql('Damla'));",
              "pm.test('Returns createdAt', () => pm.expect(pm.response.json().createdAt).to.exist);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Damla\", \"job\": \"QA Engineer\"}"
        },
        "url": "{{baseUrl}}/users"
      }
    },
    {
      "name": "Update User - PUT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Name updated', () => pm.expect(pm.response.json().name).to.eql('Damla Updated'));",
              "pm.test('updatedAt present', () => pm.expect(pm.response.json().updatedAt).to.exist);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Damla Updated\", \"job\": \"Senior QA Engineer\"}"
        },
        "url": "{{baseUrl}}/users/2"
      }
    },
