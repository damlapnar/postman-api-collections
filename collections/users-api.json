{
  "info": {
    "name": "Users API",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Complete test suite for the Users REST API — CRUD, pagination, auth, edge cases. Targets dummyjson.com rather than reqres.in: reqres now requires an x-api-key on every request (a real signup + CI secret), while dummyjson needs no auth and still has a genuine /auth/login endpoint, so the auth-flow tests didn't have to be dropped.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Users - Page 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has users array', () => { const b = pm.response.json(); pm.expect(b.users).to.be.an('array').with.lengthOf.above(0); });",
              "pm.test('Has pagination fields', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('users','total','skip','limit'); });",
              "pm.test('Response time < 800ms', () => pm.expect(pm.response.responseTime).to.be.below(800));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users?limit=5&skip=0"
      }
    },
    {
      "name": "Get Users - Page 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Skip 5 returned', () => pm.expect(pm.response.json().skip).to.eql(5));",
              "pm.test('Users is non-empty', () => pm.expect(pm.response.json().users.length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users?limit=5&skip=5"
      }
    },
    {
      "name": "Get Single User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('User ID is 2', () => pm.expect(pm.response.json().id).to.eql(2));",
              "pm.test('Has email field', () => pm.expect(pm.response.json().email).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/2"
      }
    },
    {
      "name": "Get Non-existent User - 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Error message present', () => pm.expect(pm.response.json().message).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/999999"
      }
    },
    {
      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns id', () => { const b = pm.response.json(); pm.expect(b.id).to.exist; pm.environment.set('createdUserId', b.id); });",
              "pm.test('Returns correct name', () => pm.expect(pm.response.json().firstName).to.eql('Damla'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"firstName\": \"Damla\", \"age\": 30}"
        },
        "url": "{{baseUrl}}/users/add"
      }
    },
    {
      "name": "Update User - PUT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Name updated', () => pm.expect(pm.response.json().firstName).to.eql('DamlaUpdated'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"firstName\": \"DamlaUpdated\"}"
        },
        "url": "{{baseUrl}}/users/2"
      }
    },
    {
      "name": "Update User - PATCH",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Age updated', () => pm.expect(pm.response.json().age).to.eql(99));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"age\": 99}"
        },
        "url": "{{baseUrl}}/users/2"
      }
    },
    {
      "name": "Delete User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Marked as deleted', () => pm.expect(pm.response.json().isDeleted).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "description": "dummyjson returns 200 with the deleted record (isDeleted: true), not the 204 No Content that REST convention — and reqres.in — would lead you to expect.",
        "url": "{{baseUrl}}/users/2"
      }
    },
    {
      "name": "Login - Valid Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns token', () => { const b = pm.response.json(); pm.expect(b.accessToken).to.be.a('string'); pm.environment.set('authToken', b.accessToken); });",
              "pm.test('Response time < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "description": "emilys/emilyspass is one of dummyjson's own published seed accounts (see /users), not a real credential — safe to commit.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"emilys\", \"password\": \"emilyspass\", \"expiresInMins\": 30}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login - Missing Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message present', () => pm.expect(pm.response.json().message).to.eql('Username and password required'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"emilys\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login - Invalid Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message present', () => pm.expect(pm.response.json().message).to.eql('Invalid credentials'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"emilys\", \"password\": \"wrongpass\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    }
  ]
}
